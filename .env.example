# 复制为 .env 后按需填写（Windows 下可用 set 命令或在启动脚本中设置）

# MCP 传输方式：sse（默认，对接扣子/豆包插件市场）| streamable-http | stdio（本地调试）
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# 店小宝用户密文（优先于 config.json 的 user_code）
DXB_USER_CODE=

# 发品/店铺接口基础地址（默认 https://goods.dianxiaobao.net/api-goods，一般无需修改）
DXB_API_BASE_URL=https://goods.dianxiaobao.net/api-goods

# 图片接口基础地址（默认 https://api.dianxiaobao.net/api-user，一般无需修改）
DXB_IMAGE_API_BASE_URL=https://api.dianxiaobao.net/api-user

# 可选请求头 token（有则填，无则留空）
DXB_API_TOKEN=

# 注入给发品接口的智能体名称（默认 dianxiaobao-mcp）
DXB_AGENT_NAME=dianxiaobao-mcp
